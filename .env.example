# =============================================================================
# .env.example — documents environment variables WITHOUT values (PRD §12.3, §13.4)
#
# Copy to `.env` (git-ignored) and fill in ONLY what you need.
#
# IMPORTANT: The LLM path needs NO key. Claude runs on your Max subscription via
# Claude Code login state (`claude` + /login), which lives OUTSIDE this repo.
# Every variable below is OPTIONAL.
# =============================================================================

# ---- Optional: live price feeds (only if you switch off committed CSV snapshots) ----
# POLYGON_API_KEY=
# TIINGO_API_KEY=
# ALPHAVANTAGE_API_KEY=

# ---- Optional: live news feeds for the CLEAN window (§6.2) ----
# ALPHAVANTAGE_API_KEY=      # NEWS_SENTIMENT endpoint (shared with prices above)
# CRYPTOPANIC_API_KEY=
# FINNHUB_API_KEY=
# MARKETAUX_API_KEY=
# NEWSAPI_API_KEY=

# ---- Optional: API-billed LLMs — ONLY if you opt out of subscription auth (§13.4) ----
# ANTHROPIC_API_KEY=         # switches Claude to per-token API billing
# OPENAI_API_KEY=            # only for cross-vendor (out of default scope)
